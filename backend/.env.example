# MajorScout environment variables
# Copy to backend/.env and fill in values.

# Turso (required) — https://docs.turso.tech
# turso db create majorscout
# turso db show majorscout --url
# turso db tokens create majorscout
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

SECRET_KEY=
FRONTEND_URL=

# Google OAuth (Authorized redirect URI: http://localhost:5173/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Gmail addresses that receive admin + premium access
ADMIN_EMAILS=

# Stripe subscription
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# OpenAI (gpt-4o-mini by default)
OPENAI_API_KEY=
OPENAI_MODEL=
